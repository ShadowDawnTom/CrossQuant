# Gate CrossEx API 凭证。请只给读取/交易权限，不要开启提现权限。
GATE_API_KEY=
GATE_API_SECRET=
GATE_BASE_URL=https://api.gateio.ws

# 实盘总开关。默认必须保持 false。
ENABLE_LIVE_TRADING=false

# 公网页面与所有 API 的 Google 登录保护。OAuth 回调地址必须配置为：
# https://crossquant.shadowdawn.xyz/auth/google/callback
GCT_AUTH_ENABLED=0
GCT_AUTH_BASE_URL=https://crossquant.shadowdawn.xyz
GCT_GOOGLE_CLIENT_ID=
GCT_GOOGLE_CLIENT_SECRET=
# 至少 32 字节的高熵随机值；不要提交真实值。
GCT_AUTH_SESSION_SECRET=
GCT_AUTH_ALLOWED_EMAILS=owner@example.com,operator@example.com

# 扫描参数
# 这是快照情景期，不是预期持仓时间或未来费率预测。
ARB_SCENARIO_HORIZON_HOURS=24
ARB_MIN_SNAPSHOT_ANNUALIZED=0.10
ARB_MAX_MARK_PRICE_DIVERGENCE=0.003
ARB_MAX_TICKER_AGE_MS=10000
ARB_MAX_TICKER_SKEW_MS=2000
ARB_SLIPPAGE_BPS_PER_FILL=2
ARB_DEFAULT_TAKER_FEE=0.0005

# 可执行盘口校验。目标金额表示每条腿的计价币名义价值。
ARB_TARGET_NOTIONAL=100
ARB_MAX_ORDER_BOOK_AGE_MS=3000
ARB_MAX_ORDER_BOOK_SKEW_MS=1000
ARB_ORDER_BOOK_TIMEOUT_SECONDS=8
# 常驻执行行情 Hub。只有该服务返回 LIVE_SYNCHRONIZED 时，预检才可能通过。
ARB_EXECUTION_MARKET_URL=http://127.0.0.1:17840

# 后端四所行情源。区域网络不可达时可改成交易所官方区域域名，不能改成第三方聚合源。
GCT_EXECUTION_MARKET_SYMBOLS=BTC,ETH
GCT_EXECUTION_MAX_BOOK_AGE_MS=1500
GCT_EXECUTION_MAX_EXCHANGE_SKEW_MS=750
GCT_EXECUTION_MAX_RECEIVE_SKEW_MS=750
GCT_GATE_FUTURES_REST_URL=https://api.gateio.ws/api/v4
GCT_GATE_FUTURES_WS_URL=wss://fx-ws.gateio.ws/v4/ws/usdt
GCT_BINANCE_FUTURES_REST_URL=https://fapi.binance.com
GCT_BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/public/ws
GCT_OKX_REST_URL=https://openapi.okx.com
GCT_OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
GCT_BYBIT_REST_URL=https://api.bybit.com
GCT_BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# 只读实盘预检阈值。预检只生成订单草案，不会发送。
ARB_PREFLIGHT_MAX_NOTIONAL=100
ARB_PREFLIGHT_MIN_INITIAL_MARGIN_RATE=1.5
ARB_PREFLIGHT_MIN_MAINTENANCE_MARGIN_RATE=1.5
ARB_PREFLIGHT_LIMIT_SLIPPAGE_BPS=5
ARB_PREFLIGHT_MAX_ACCOUNT_AGE_MS=10000
