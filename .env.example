# Gate CrossEx API 凭证。请只给读取/交易权限，不要开启提现权限。
GATE_API_KEY=
GATE_API_SECRET=
GATE_BASE_URL=https://api.gateio.ws

# 实盘总开关。默认必须保持 false。
ENABLE_LIVE_TRADING=false

# 扫描参数
# 这是快照情景期，不是预期持仓时间或未来费率预测。
ARB_SCENARIO_HORIZON_HOURS=24
ARB_MIN_SNAPSHOT_ANNUALIZED=0.10
ARB_MAX_MARK_PRICE_DIVERGENCE=0.003
ARB_MAX_TICKER_AGE_MS=10000
ARB_MAX_TICKER_SKEW_MS=2000
ARB_SLIPPAGE_BPS_PER_FILL=2
ARB_DEFAULT_TAKER_FEE=0.0005

# 可执行盘口校验。目标金额表示每条腿的计价币名义价值。
ARB_TARGET_NOTIONAL=100
ARB_MAX_ORDER_BOOK_AGE_MS=3000
ARB_MAX_ORDER_BOOK_SKEW_MS=1000
ARB_ORDER_BOOK_TIMEOUT_SECONDS=8
