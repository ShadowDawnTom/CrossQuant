[Unit]
Description=CrossQuant public read-only terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/code/CrossQuant-current/frontend
Environment=NODE_ENV=production
Environment=GCT_HOST=127.0.0.1
Environment=GCT_PORT=17840
Environment=GCT_FRONTEND_PORT=17840
Environment=GCT_FRONTEND_ORIGIN=https://crossquant.shadowdawn.xyz
Environment=GCT_ALLOWED_HOSTS=crossquant.shadowdawn.xyz
Environment=GCT_PUBLIC_READONLY=1
Environment=GCT_DATA_DIR=/home/ubuntu/.local/share/crossquant
Environment=GCT_MIGRATIONS_DIR=/home/ubuntu/code/CrossQuant-current/frontend/migrations
Environment=GCT_FRONTEND_DIST_DIR=/home/ubuntu/code/CrossQuant-current/frontend/apps/frontend/dist
Environment=GCT_DISABLE_OS_KEYCHAIN=1
Environment=GCT_CREDENTIAL_ENV_PATH=/home/ubuntu/.local/share/crossquant/credentials.env
Environment=GCT_FUNDING_LIVE_ENABLED=0
Environment=GCT_FUNDING_MAX_NOTIONAL_PER_LEG_USD=0
Environment=GCT_FUNDING_MAX_CONCURRENT_TRADES=0
Environment=GCT_RISK_MAX_GROSS_EXPOSURE_USD=0
Environment=GCT_RISK_MAX_DAILY_LOSS_USD=0
Environment=GCT_EXECUTION_MARKET_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,ZEC,JUP,SUI,LINK,BCH
Environment=GCT_FUNDING_SCAN_ASSETS=BTC,ETH,SOL
Environment=GCT_FUNDING_PAPER_ENABLED=1
Environment=GCT_FUNDING_PAPER_MAX_OPEN_POSITIONS=3
Environment=GCT_FUNDING_RESEARCH_ENABLED=1
Environment=GCT_FUNDING_RESEARCH_MODEL_VERSION=rolling_v4
Environment=GCT_FUNDING_RESEARCH_ASSETS=BTC,ETH,SOL,XRP,DOGE,ADA,SUI,AVAX,LINK,LTC,BCH,DOT,UNI,AAVE,NEAR,APT,ARB,OP,INJ,ATOM,FIL,ETC,XLM,HBAR,TRX,SEI,JUP,TAO,WIF,PEPE,ZEC,TON,SHIB,POL,BNB,EOS,GALA,SAND,MANA,CRV,LDO,RUNE,IMX,STX,TIA,PYTH,ENA,WLD,ORDI,NOT,FET,ICP,DYDX,GMX,KAS,ALGO,VET,FLOW,THETA,MKR,COMP,SNX,BONK,FLOKI,POPCAT,PENGU,TRUMP,KAITO,ONDO,PENDLE,JTO,STRK,AEVO,BLUR,MEME,NEO,IOTA,QTUM,CELO,JASMY
Environment=GCT_FUNDING_RESEARCH_TARGET_NOTIONAL_USD=5
Environment=GCT_FUNDING_RESEARCH_MAX_ACTUAL_NOTIONAL_USD=10
Environment=GCT_FUNDING_RESEARCH_MAX_OPEN_POSITIONS=3
Environment=GCT_FUNDING_RESEARCH_MAX_SLIPPAGE_BPS=10
Environment=GCT_FUNDING_RESEARCH_MIN_SETTLED_EVENTS=1
Environment=GCT_FUNDING_RESEARCH_MIN_LIQUIDITY_USD=1000
Environment=GCT_FUNDING_RESEARCH_LIQUIDITY_DEPTH_BPS=10
Environment=GCT_FUNDING_RESEARCH_MAX_PAIRS_PER_ASSET=1
Environment=GCT_FUNDING_RESEARCH_STABLECOIN_RISK_BPS=5
Environment=GCT_FUNDING_RESEARCH_ROLLING_SOFT_REVIEW_MS=259200000
Environment=GCT_FUNDING_RESEARCH_ROLLING_HARD_HOLDING_MS=604800000
Environment=GCT_FUNDING_RESEARCH_HOLD_EXIT_CONFIRMATIONS=60
Environment=GCT_FUNDING_RESEARCH_REVERSAL_EXIT_CONFIRMATIONS=30
Environment=GCT_FUNDING_RESEARCH_REENTRY_COOLDOWN_MS=43200000
Environment=GCT_FUNDING_RESEARCH_HOLD_STRESS_SLIPPAGE_BPS=2
Environment=GCT_FUNDING_RESEARCH_HOLD_ADVERSE_BASIS_BPS=3
Environment=GCT_FUNDING_DISCOVERY_HOT_POOL_SIZE=10
Environment=GCT_FUNDING_DISCOVERY_MIN_OPEN_INTEREST_USD=1000000
Environment=GCT_FUNDING_DISCOVERY_PROMOTION_CONFIRMATIONS=3
Environment=GCT_FUNDING_DISCOVERY_MIN_EDGE_DURATION_MS=900000
Environment=GCT_FUNDING_DISCOVERY_MAX_DIRECTION_FLIPS_24H=3
Environment=GCT_FUNDING_DISCOVERY_SNAPSHOT_INTERVAL_MS=300000
Environment=GCT_FUNDING_DISCOVERY_MIN_HOT_DWELL_MS=1800000
ExecStart=/opt/node-v24.14.0-linux-x64/bin/node apps/backend/dist/server.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
